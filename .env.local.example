# --- Required ---------------------------------------------------------------

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# The host looks like  yourcluster.abc12.mongodb.net  (not "cluster.mongodb.net").
MONGODB_URI=mongodb+srv://USER:PASSWORD@yourcluster.abc12.mongodb.net/shoeforshoeless

# Paystack (Dashboard > Settings > API Keys & Webhooks). Use sk_test_ until launch.
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Public site URL. Paystack sends donors back to  $NEXT_PUBLIC_BASE_URL/thank-you
# Production: https://shoefortheshoeless.org
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Paystack webhook URL to register in the dashboard (production):
#   https://shoefortheshoeless.org/api/webhooks/paystack

# --- Optional (not used by the UI yet) --------------------------------------

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
